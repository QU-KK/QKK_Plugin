{
  "name": "Unity URP",
  "notes": "Universal Render Pipeline Lit inputs. Unity wants smoothness, not roughness, so the Metallic Smoothness map takes roughness inverted into alpha.",
  "outputs": [
    {
      "bit_depth": 8,
      "channels": {
        "A": {
          "channel": "GRAY",
          "invert": false,
          "source": "MATERIAL_OPACITY"
        },
        "B": {
          "channel": "B",
          "invert": false,
          "source": "MATERIAL_ALBEDO"
        },
        "G": {
          "channel": "G",
          "invert": false,
          "source": "MATERIAL_ALBEDO"
        },
        "R": {
          "channel": "R",
          "invert": false,
          "source": "MATERIAL_ALBEDO"
        }
      },
      "color_space": "SRGB",
      "filename": "$textureSet_BaseMap",
      "format": "PNG"
    },
    {
      "bit_depth": 8,
      "channels": {
        "A": {
          "channel": "GRAY",
          "invert": true,
          "source": "MATERIAL_ROUGHNESS"
        },
        "B": null,
        "G": null,
        "R": {
          "channel": "GRAY",
          "invert": false,
          "source": "MATERIAL_METALNESS"
        }
      },
      "color_space": "LINEAR",
      "filename": "$textureSet_MetallicSmoothness",
      "format": "PNG",
      "notes": "Alpha is smoothness = 1 - roughness."
    },
    {
      "bit_depth": 16,
      "channels": {
        "A": null,
        "B": {
          "channel": "B",
          "invert": false,
          "source": "NORMAL"
        },
        "G": {
          "channel": "G",
          "invert": false,
          "source": "NORMAL"
        },
        "R": {
          "channel": "R",
          "invert": false,
          "source": "NORMAL"
        }
      },
      "color_space": "LINEAR",
      "filename": "$textureSet_Normal",
      "format": "PNG"
    },
    {
      "bit_depth": 8,
      "channels": {
        "A": null,
        "B": {
          "channel": "GRAY",
          "invert": false,
          "source": "AO"
        },
        "G": {
          "channel": "GRAY",
          "invert": false,
          "source": "AO"
        },
        "R": {
          "channel": "GRAY",
          "invert": false,
          "source": "AO"
        }
      },
      "color_space": "LINEAR",
      "filename": "$textureSet_Occlusion",
      "format": "PNG"
    },
    {
      "bit_depth": 8,
      "channels": {
        "A": null,
        "B": {
          "channel": "B",
          "invert": false,
          "source": "MATERIAL_EMISSION"
        },
        "G": {
          "channel": "G",
          "invert": false,
          "source": "MATERIAL_EMISSION"
        },
        "R": {
          "channel": "R",
          "invert": false,
          "source": "MATERIAL_EMISSION"
        }
      },
      "color_space": "SRGB",
      "filename": "$textureSet_Emission",
      "format": "PNG"
    }
  ],
  "schema": "master_baker.output_template.v1"
}
